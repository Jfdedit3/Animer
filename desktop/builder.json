{
  "appId": "fr.animer.desktop",
  "productName": "Animer",
  "electronVersion": "44.4.3",
  "directories": {
    "app": "dist/linux-app",
    "output": "dist/linux"
  },
  "files": [
    "main.cjs",
    "worker.mjs",
    "icon.png",
    "package.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!node_modules/**/*"
  ],
  "asar": true,
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "AudioVideo",
    "icon": "public/icon.png",
    "artifactName": "Animer-${version}-linux-x86_64.${ext}",
    "executableName": "animer",
    "desktop": {
      "entry": {
        "Name": "Animer",
        "Comment": "Anime, épisodes et bibliothèque locale",
        "Keywords": "anime;video;streaming;"
      }
    },
    "syncDesktopName": true
  },
  "deb": {
    "maintainer": "Animer <noreply@users.noreply.github.com>",
    "depends": [
      "libgtk-3-0 | libgtk-3-0t64",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0",
      "libuuid1",
      "libsecret-1-0",
      "libgbm1",
      "libasound2 | libasound2t64",
      "libcups2 | libcups2t64"
    ],
    "compression": "gz"
  },
  "npmRebuild": false
}
